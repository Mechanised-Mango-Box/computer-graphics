      "isDeleted": false,
      "boundElements": [],
      "updated": 1782394175998,
      "link": null,
      "locked": false,
      "text": "Doing these calculations for each neighbour is too expensive",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Doing these calculations for each neighbour is too expensive",
